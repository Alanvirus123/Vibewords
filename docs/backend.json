{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile and personalized settings within the CaptionWise application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the UserProfile entity."
        },
        "themePreference": {
          "type": "string",
          "description": "The user's preferred application theme."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "themePreference",
        "createdAt",
        "updatedAt"
      ]
    },
    "HistoryItem": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "HistoryItem",
      "type": "object",
      "description": "Represents a bookmarked creative asset (caption or song) saved by the user in their Neural Vault.",
      "properties": {
        "id": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["caption", "song"] },
        "metadata": { "type": "object" },
        "savedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["content", "type", "savedAt"]
    },
    "Image": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Image",
      "type": "object",
      "description": "Represents an image uploaded by a user.",
      "properties": {
        "id": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string",
          "format": "uri"
        },
        "fileName": {
          "type": "string"
        },
        "mimeType": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "number"
        },
        "uploadedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "userId",
        "imageUrl",
        "fileName",
        "mimeType",
        "sizeBytes",
        "uploadedAt"
      ]
    },
    "CaptionSuggestion": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CaptionSuggestion",
      "type": "object",
      "description": "Represents a caption suggested for an image.",
      "properties": {
        "id": {
          "type": "string"
        },
        "imageId": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "isUserRefined": {
          "type": "boolean"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastModifiedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "imageId",
        "text",
        "isUserRefined",
        "generatedAt",
        "lastModifiedAt"
      ]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          }
        }
      },
      {
        "path": "/users/{userId}/history/{itemId}",
        "definition": {
          "entityName": "HistoryItem",
          "schema": {
            "$ref": "#/backend/entities/HistoryItem"
          }
        }
      },
      {
        "path": "/users/{userId}/images/{imageId}",
        "definition": {
          "entityName": "Image",
          "schema": {
            "$ref": "#/backend/entities/Image"
          }
        }
      },
      {
        "path": "/users/{userId}/images/{imageId}/captionSuggestions/{captionSuggestionId}",
        "definition": {
          "entityName": "CaptionSuggestion",
          "schema": {
            "$ref": "#/backend/entities/CaptionSuggestion"
          }
        }
      }
    ],
    "reasoning": "Updated to include the HistoryItem entity for the Neural Vault feature, following path-based ownership."
  }
}
